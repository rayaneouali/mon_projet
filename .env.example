# Modèle du fichier .env (configuration locale).
# 1. Copie ce fichier :  cp .env.example .env
# 2. Remplis les valeurs dans .env (JAMAIS dans ce fichier-ci : lui est sur GitHub).
# En ligne (Streamlit Cloud), les mêmes noms se mettent dans « Secrets ».

# Adresse de la base Supabase : bouton « Connect » > « Session pooler ».
# Remplace [YOUR-PASSWORD] par le mot de passe de la base.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Codes d'accès (6 chiffres conseillés, deux codes différents).
# CODE_CHEFS : Saisie, Semaine, Samedis.   CODE_ADMIN : tout, y compris Admin.
CODE_CHEFS=000000
CODE_ADMIN=999999

# Niveau de détail des logs : DEBUG (affiche le SQL), INFO (normal), WARNING, ERROR.
LOG_LEVEL=INFO

# Optionnel, pour les tests seulement : une autre base que DATABASE_URL.
# Les tests travaillent de toute façon dans un schéma temporaire qu'ils effacent.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

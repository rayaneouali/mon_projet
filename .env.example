# Copy this file to .env (cp .env.example .env) and fill in the values.
# .env is ignored by git: your secrets never leave your computer.

# Environment name: local, test or production
APP_ENV=local
# Log verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Anthropic API key (Claude). Create one at https://console.anthropic.com
# Needed from phase 1 to talk to the real model. Unit tests do not need it.
ANTHROPIC_API_KEY=
# Claude model used by the agent (claude-sonnet-5 is cheaper, claude-opus-5 is smarter)
ANTHROPIC_MODEL=claude-opus-5

# Signature added at the end of every email
USER_SIGNATURE="Rayane Ouali"

# Phase 1 only: fake contact book used instead of Google Contacts
CONTACTS_FILE=data/fake_contacts.json
# Seconds during which a validated email can still be cancelled
SEND_DELAY_SECONDS=30
